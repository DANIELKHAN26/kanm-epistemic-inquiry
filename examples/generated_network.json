{
  "schema_version": 1,
  "description": "Ten agents on a seeded Erdos-Renyi network; illustrative settings only.",
  "truth": true,
  "steps": 50,
  "seed": 7,
  "trust_points": 101,
  "update_rule": "laputa",
  "schedule": "simultaneous",
  "assertion_rule": "published",
  "n_agents": 10,
  "agent_defaults": {
    "prior_belief": 0.5,
    "inquiry_accuracy": 0.7,
    "inquiry_chance": 0.4,
    "inquiry_trust_mean": 0.6,
    "inquiry_trust_concentration": 8.0
  },
  "network": {"type": "erdos_renyi", "p": 0.3, "seed": 7},
  "edge_defaults": {
    "listen_chance": 0.5,
    "assertion_threshold": 0.75,
    "trust_mean": 0.6,
    "trust_concentration": 8.0
  }
}
